{
  "name": "fun",
  "version": "0.1.0",
  "private": true,
  "description": "Read a Ninja ProChef WP100 wireless thermometer in the browser over Web Bluetooth.",
  "license": "MIT",
  "author": "Nano Gennari <me@nngn.net>",
  "type": "module",
  "keywords": [
    "web-bluetooth",
    "bluetooth-low-energy",
    "thermometer",
    "ninja-prochef",
    "reverse-engineering",
    "cloudflare-pages",
    "pwa"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "python3 -m http.server 8788 --directory public",
    "dev": "wrangler pages dev public --port 8788",
    "test": "node --test test/",
    "deploy": "wrangler pages deploy public --project-name fun"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
